# Raw downloads are large and re-downloadable. See data/raw/SOURCES.md for
# every URL + retrieval date so anyone can rebuild data/raw/ from scratch.
#
# NOTE the pattern: `data/raw/**` excludes everything beneath data/raw
# recursively. An earlier version used `data/raw/*` plus `!data/raw/**/`,
# which re-included the SUBDIRECTORIES — git then descended into them and
# committed the 87MB workbook by accident. Do not re-add a directory
# negation here.
data/raw/**
!data/raw/.gitkeep
!data/raw/SOURCES.md

# CPI-U arrives as a pasted table rather than a download, so it is small,
# not re-fetchable by URL, and belongs in version control.
!data/raw/cpi/
!data/raw/cpi/cpi_u_cuur0000sa0_monthly.txt

# Script output. Disposable — regenerated by re-running src/.
data/interim/*
!data/interim/.gitkeep

# Built analysis datasets. Small enough to commit if you want reviewers to
# skip the build step; drop the next line if you'd rather track them.
data/processed/*
!data/processed/.gitkeep

# NOTE: data/crosswalks/ is deliberately NOT ignored. The course-provided
# county_oews_crosswalk.csv is small and not re-downloadable, so it ships
# with the repo.

# Python
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Jupyter/Quarto build artifacts
*.quarto_ipynb
.quarto/
_files/

# macOS
.DS_Store
